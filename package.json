{
  "name": "pdi",
  "version": "5.0.0",
  "description": "Minimal Promise based dependency injection framework",
  "type": "module",
  "repository": "https://github.com/davidgtonge/pdi",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && npm run test:unit",
    "test:unit": "mocha",
    "test:watch": "npm run build && mocha -w",
    "lint": "tsc --noEmit"
  },
  "author": "Dave Tonge <919587+davidgtonge@users.noreply.github.com> (https://github.com/davidgtonge)",
  "license": "ISC",
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.21",
    "@types/sinon": "^17.0.4",
    "mocha": "^11.6.0",
    "sinon": "^20.0.0",
    "typescript": "^5.8.3"
  }
}
